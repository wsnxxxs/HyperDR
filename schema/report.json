{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HyperDR conversion report schema 13",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool",
    "settings",
    "files"
  ],
  "properties": {
    "schema": {
      "const": 13
    },
    "tool": {
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "color_lut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "input",
        "output",
        "strength"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "color_gamut",
        "clamp_srgb",
        "look",
        "raw_gain",
        "contrast",
        "vibrance",
        "pop",
        "headroom_max",
        "expansion_start",
        "area_coverage",
        "gain_strength",
        "exposure_bias",
        "exposure",
        "headroom",
        "quality",
        "hevc_preset",
        "depth",
        "preview_max_edge",
        "recursive",
        "verify_output",
        "overwrite",
        "skip_existing",
        "half_size",
        "toe_end",
        "toe_output_ratio",
        "positive_exposure_limit",
        "output_depth"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "adaptive",
            "iso-gainmap-jpeg",
            "pq",
            "hlg",
            "avif-pq",
            "avif-hlg",
            "sdr-jpeg",
            "sdr-tiff"
          ]
        },
        "color_gamut": {
          "enum": [
            "srgb",
            "p3",
            "rec2020"
          ]
        },
        "output_gamut": {
          "enum": [
            "auto",
            "srgb",
            "p3"
          ]
        },
        "clamp_srgb": {
          "type": "boolean"
        },
        "look": {
          "enum": [
            "photographic"
          ]
        },
        "raw_gain": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64
        },
        "contrast": {
          "type": "number"
        },
        "vibrance": {
          "type": "number"
        },
        "pop": {
          "type": "number"
        },
        "headroom_max": {
          "type": "number"
        },
        "expansion_start": {
          "type": "number"
        },
        "area_coverage": {
          "type": "number"
        },
        "gain_strength": {
          "type": "number"
        },
        "exposure_bias": {
          "type": "number"
        },
        "exposure": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "number"
            }
          ]
        },
        "headroom": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "number"
            }
          ]
        },
        "quality": {
          "type": "integer"
        },
        "hevc_preset": {
          "enum": [
            "slow",
            "medium"
          ]
        },
        "depth": {
          "enum": [
            8,
            10
          ]
        },
        "preview_max_edge": {
          "type": "integer",
          "minimum": 0
        },
        "recursive": {
          "type": "boolean"
        },
        "verify_output": {
          "type": "boolean"
        },
        "overwrite": {
          "type": "boolean"
        },
        "skip_existing": {
          "type": "boolean"
        },
        "half_size": {
          "type": "boolean"
        },
        "toe_end": {
          "type": "number"
        },
        "toe_output_ratio": {
          "type": "number"
        },
        "positive_exposure_limit": {
          "type": "number"
        },
        "output_depth": {
          "enum": [
            8,
            10,
            16
          ]
        },
        "ai_model_id": {
          "type": "string",
          "minLength": 1
        },
        "ai_post": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brightness_ev",
            "contrast",
            "shadows_ev",
            "highlights_stops",
            "hdr_range_stops",
            "expansion_start"
          ],
          "properties": {
            "brightness_ev": {
              "type": "number"
            },
            "contrast": {
              "type": "number"
            },
            "shadows_ev": {
              "type": "number"
            },
            "highlights_stops": {
              "type": "number"
            },
            "hdr_range_stops": {
              "type": "number"
            },
            "expansion_start": {
              "type": "number"
            }
          }
        },
        "lut_input": {
          "type": "string",
          "enum": [
            "srgb",
            "p3",
            "rec709",
            "hlg",
            "pq",
            "slog3-sgamut3cine"
          ]
        },
        "lut_output": {
          "type": "string",
          "enum": [
            "srgb",
            "p3",
            "rec709",
            "hlg",
            "pq",
            "slog3-sgamut3cine"
          ]
        },
        "lut_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gain_map_output": {
          "type": "boolean"
        },
        "raw_lens_correction": {
          "type": "boolean"
        }
      }
    },
    "raw_processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "decoder_version",
        "os_build",
        "digital_gain",
        "baseline_exposure"
      ],
      "properties": {
        "engine": {
          "const": "apple-ciraw"
        },
        "decoder_version": {
          "type": "string"
        },
        "os_build": {
          "type": "string"
        },
        "digital_gain": {
          "type": "number"
        },
        "baseline_exposure": {
          "type": "number"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "success",
        "skipped",
        "self_verified",
        "message",
        "sensor_width",
        "sensor_height",
        "requested_crop_width",
        "requested_crop_height",
        "delivered_crop_width",
        "delivered_crop_height",
        "target_dimensions_applied",
        "default_crop_present",
        "decode_degraded",
        "decode_degradation_reasons",
        "input_domain",
        "input_headroom",
        "model_development",
        "model_requested_id",
        "model_id",
        "model_version",
        "model_inference_mode",
        "model_fallback_reason",
        "width",
        "height",
        "exposure_ev",
        "headroom_stops",
        "gain_min",
        "gain_max",
        "decode_ms",
        "process_ms",
        "encode_ms",
        "codec_ms",
        "verify_ms",
        "write_ms",
        "look",
        "render",
        "gain_map"
      ],
      "properties": {
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "self_verified": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "error_code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "sensor_width": {
          "$ref": "#/$defs/dimension"
        },
        "sensor_height": {
          "$ref": "#/$defs/dimension"
        },
        "requested_crop_width": {
          "$ref": "#/$defs/dimension"
        },
        "requested_crop_height": {
          "$ref": "#/$defs/dimension"
        },
        "delivered_crop_width": {
          "$ref": "#/$defs/dimension"
        },
        "delivered_crop_height": {
          "$ref": "#/$defs/dimension"
        },
        "target_dimensions_applied": {
          "type": "boolean"
        },
        "default_crop_present": {
          "type": "boolean"
        },
        "decode_degraded": {
          "type": "boolean"
        },
        "input_domain": {
          "type": "string",
          "enum": [
            "scene-referred",
            "display-referred-sdr",
            "display-referred-hdr",
            "dual-rendition",
            "unknown"
          ]
        },
        "source_color": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "primaries",
            "transfer",
            "source"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "primaries": {
              "type": "string"
            },
            "transfer": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "input_headroom": {
          "type": "number",
          "minimum": 1
        },
        "model_development": {
          "type": "string",
          "enum": [
            "none",
            "display-p3-passthrough",
            "raw-neutral-v1",
            "raw-dcp-v1",
            "display-hdr-split"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_requested_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "model_inference_mode": {
          "type": "string",
          "enum": [
            "none",
            "not_run",
            "pixel_only",
            "exif_assisted",
            "pixel_only_fallback"
          ]
        },
        "model_fallback_reason": {
          "type": "string"
        },
        "decode_degradation_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frame": {
          "description": "Present when a presentation frame was placed: width and height are then the canvas, and photo is where the photograph sits on it.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "photo"
          ],
          "properties": {
            "width": {
              "$ref": "#/$defs/dimension"
            },
            "height": {
              "$ref": "#/$defs/dimension"
            },
            "variant": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,32}$"
            },
            "photo": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "type": "integer",
                  "minimum": 0
                },
                "width": {
                  "$ref": "#/$defs/dimension"
                },
                "height": {
                  "$ref": "#/$defs/dimension"
                }
              }
            }
          }
        },
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "height": {
          "$ref": "#/$defs/dimension"
        },
        "exposure_ev": {
          "type": "number"
        },
        "headroom_stops": {
          "type": "number"
        },
        "gain_min": {
          "type": "number"
        },
        "gain_max": {
          "type": "number"
        },
        "decode_ms": {
          "$ref": "#/$defs/duration"
        },
        "process_ms": {
          "$ref": "#/$defs/duration"
        },
        "codec_ms": {
          "type": "number"
        },
        "verify_ms": {
          "type": "number"
        },
        "write_ms": {
          "type": "number"
        },
        "encode_ms": {
          "$ref": "#/$defs/duration"
        },
        "look": {
          "$ref": "#/$defs/look"
        },
        "render": {
          "$ref": "#/$defs/render"
        },
        "gain_map": {
          "$ref": "#/$defs/gain_map"
        },
        "raw_processing": {
          "$ref": "#/$defs/raw_processing"
        },
        "raw_lens_correction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "applied"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "applied": {
              "type": "boolean"
            }
          }
        },
        "error_detail": {
          "type": "object"
        }
      }
    },
    "dimension": {
      "type": "integer",
      "minimum": 0
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure_ev",
        "ev100",
        "target_middle_gray"
      ],
      "properties": {
        "exposure_ev": {
          "type": "number"
        },
        "ev100": {
          "type": [
            "number",
            "null"
          ]
        },
        "target_middle_gray": {
          "type": "number"
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headroom_stops",
        "headroom_linear",
        "rendered_peak",
        "headroom_utilization",
        "below_knee_relative_difference_max",
        "wide_gamut_fraction",
        "wide_gamut_pixels",
        "wide_gamut_eligible_pixels",
        "wide_gamut_luminance_threshold"
      ],
      "properties": {
        "headroom_stops": {
          "type": "number"
        },
        "headroom_linear": {
          "type": "number"
        },
        "rendered_peak": {
          "type": "number"
        },
        "headroom_utilization": {
          "type": "number"
        },
        "below_knee_relative_difference_max": {
          "type": "number"
        },
        "wide_gamut_fraction": {
          "type": "number"
        },
        "wide_gamut_pixels": {
          "type": "integer",
          "minimum": 0
        },
        "wide_gamut_eligible_pixels": {
          "type": "integer",
          "minimum": 0
        },
        "wide_gamut_luminance_threshold": {
          "type": "number"
        }
      }
    },
    "gain_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gamma",
        "min_stops",
        "max_stops"
      ],
      "properties": {
        "adaptive_chroma_loss": {
          "type": "boolean"
        },
        "gamma": {
          "type": "number"
        },
        "min_stops": {
          "type": "number"
        },
        "max_stops": {
          "type": "number"
        },
        "percentiles_stops": {
          "$ref": "#/$defs/percentiles"
        },
        "fraction_gt_0_5": {
          "type": "number"
        },
        "fraction_gt_1_0": {
          "type": "number"
        },
        "fraction_gt_2_0": {
          "type": "number"
        },
        "clipped_fraction": {
          "type": "number"
        },
        "local_weight_mean": {
          "type": "number"
        },
        "local_weight_p95": {
          "type": "number"
        }
      }
    },
    "percentiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50",
        "p75",
        "p90",
        "p95",
        "p99",
        "p99_9",
        "p99_99",
        "max"
      ],
      "properties": {
        "p50": {
          "type": "number"
        },
        "p75": {
          "type": "number"
        },
        "p90": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        },
        "p99": {
          "type": "number"
        },
        "p99_9": {
          "type": "number"
        },
        "p99_99": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    }
  }
}
