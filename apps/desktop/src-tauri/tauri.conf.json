{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperDR",
  "version": "0.1.0",
  "identifier": "com.hyperdr.desktop",
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../packaging/build-tauri-sidecar.ps1",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/hyperdr-panel"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
