{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the HyperDR desktop shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/hyperdr-panel",
          "sidecar": true,
          "args": ["--desktop"]
        }
      ]
    }
  ]
}
