    "err.server.export_dimension_limit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The export is wider or taller than this format’s 65,500-pixel limit, so nothing was exported. Choose HEIC or TIFF, or a smaller frame style, and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出尺寸超过这种格式每边 65,500 像素的上限，所以没有导出。可以换用 HEIC 或 TIFF，或换一种较小的边框样式后再试。"
          }
        }
      }
    },
    "err.server.export_dimension_limit.color" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
