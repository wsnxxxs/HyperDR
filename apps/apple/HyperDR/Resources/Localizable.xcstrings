    "err.server.export_memory_budget.frame" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporting this photo needs more memory than this Mac can spare, so nothing was exported. Remove the frame or choose a smaller frame style and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出这张照片所需的内存超过本机能腾出的额度，所以没有导出。可以去掉边框或换一种较小的边框样式后再试。"
          }
        }
      }
    },
    "err.server.export_memory_budget.noFrame" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporting this photo needs more memory than this Mac can spare, so nothing was exported. Close other apps and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出这张照片所需的内存超过本机能腾出的额度，所以没有导出。可以关闭其他应用后再试。"
          }
        }
      }
    },
