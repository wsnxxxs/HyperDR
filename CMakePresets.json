{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HYPERDR_WITH_CODECS": "OFF"
      }
    },
    {
      "name": "codecs",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HYPERDR_WITH_CODECS": "ON",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/ports"
      }
    },
    {
      "name": "macos-arm64-core",
      "inherits": "core",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    },
    {
      "name": "macos-arm64-codecs",
      "inherits": "codecs",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "ios-arm64-codecs",
      "inherits": "codecs",
      "displayName": "iOS arm64 (device slice)",
      "description": "Engine writer slice for iOS devices.",
      "binaryDir": "${sourceDir}/build-ios",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "27.0",
        "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-ios",
        "HYPERDR_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ios-simulator-arm64-codecs",
      "inherits": "ios-arm64-codecs",
      "displayName": "iOS arm64 (simulator slice)",
      "binaryDir": "${sourceDir}/build-ios-simulator",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "VCPKG_TARGET_TRIPLET": "arm64-ios-simulator"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64-core",
      "configurePreset": "macos-arm64-core"
    },
    {
      "name": "macos-arm64-codecs",
      "configurePreset": "macos-arm64-codecs"
    },
    {
      "name": "ios-arm64-codecs",
      "configurePreset": "ios-arm64-codecs"
    },
    {
      "name": "ios-simulator-arm64-codecs",
      "configurePreset": "ios-simulator-arm64-codecs"
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64-core",
      "configurePreset": "macos-arm64-core",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "macos-arm64-codecs",
      "configurePreset": "macos-arm64-codecs",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
