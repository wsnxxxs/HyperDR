*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
secrets/


__pycache__/
*.pyc
/.pytest_cache/
/hdr-workspace/
/output/
/.playwright-cli/
/dist/
/dist-release-*/
/release-stage/
/.workbuddy/

# Resume sidecars and decode caches live beside conversion output.
.hyperdr/
*.hdrcache

