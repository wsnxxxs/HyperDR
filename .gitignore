/build*/
/.vs/
/.vscode/
/.sync_probe
.idea/
.clangd/
*.heic
!tests/macos_t2/fixtures/*.heic
# Files a real macOS run refused, and the offline probes that attribute it.
!tests/macos_t2/fixtures-prerepair/*.heic
!tests/macos_t2/probes/*.heic
# Third-party captures used only to attribute a decoder refusal. They are other
# people's pixels carrying their original EXIF, and one is a dataset original, so
# they are hand-carried in the transfer bundle and never committed.
tests/macos_t2/reference/*
!tests/macos_t2/reference/README.md
*.ARW
*.arw
*.tif
*.tiff
*.jsonl
*.obj

# Local configuration, credentials, and development certificates.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
secrets/


__pycache__/
*.pyc
/.pytest_cache/
/output/
/.workbuddy/

# Resume sidecars and decode caches live beside conversion output.
.hyperdr/
*.hdrcache

# Local test fixtures and generated conversion reports.
/test-data/
/reports/
*.report.json
/.tmp-*/

# Agent worktrees and local agent state.
.claude/
/.codex-remote-attachments/

# Bundled local ML runtime and private trained weights are machine-local.
/HyperDR_Model/.venv/
/HyperDR_Model/checkpoints/*.pt
# The AI models are private: no weights in the repository. Official builds
# put research-cnn-v1.mlpackage into HyperDRRender's Resources/Models/.
/HyperDR_Model/models/
/apps/apple/Packages/HyperDRRender/Sources/HyperDRRender/Resources/Models/*
!/apps/apple/Packages/HyperDRRender/Sources/HyperDRRender/Resources/Models/README.md
/HyperDR_Model/reports/

# Keep documentation local.
/docs/

# Finder metadata
.DS_Store

# SwiftPM build output of the Swift packages.
apps/apple/Packages/*/.build/
