{
  "sourceLanguage" : "en",
  "strings" : {
    "adjust.noProfile" : {
      "comment" : "In place of the lens correction switch when the system has no lens profile for this camera. Do not claim the photo is corrected automatically.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No profile available" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂无配置文件" } }
      }
    },
    "design.lut.library" : {
      "comment" : "Button beside the LUT menu that opens the LUT library.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "LUT Library" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "LUT 库" } }
      }
    },
    "ctrl.color.saturation.help" : {
      "comment" : "Adjustment control help (color.saturation).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scales all colours evenly; −100 is black and white, with HDR highlights kept." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "均匀缩放所有颜色；−100 为黑白，高光仍是 HDR。" } }
      }
    },
    "ctrl.color.saturation.label" : {
      "comment" : "Adjustment control name (color.saturation).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Saturation" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "饱和度" } }
      }
    },
    "ctrl.color.tint.help" : {
      "comment" : "Adjustment control help (color.tint).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Shifts colours towards green or magenta; brightness stays the same." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "让颜色偏绿或偏品红；亮度不变。" } }
      }
    },
    "ctrl.color.tint.label" : {
      "comment" : "Adjustment control name (color.tint).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tint" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "色调" } }
      }
    },
    "ctrl.color.vibrance.help" : {
      "comment" : "Adjustment control help (color.vibrance).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes muted colours more than saturated ones." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "优先改变不饱和的颜色。" } }
      }
    },
    "ctrl.color.vibrance.label" : {
      "comment" : "Adjustment control name (color.vibrance).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Vibrance" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自然饱和度" } }
      }
    },
    "ctrl.color.warmth.help" : {
      "comment" : "Adjustment control help (color.warmth).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Makes the photo warmer or cooler; brightness, HDR highlights included, stays the same." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "让照片更暖或更冷；亮度（包括 HDR 高光）不变。" } }
      }
    },
    "ctrl.color.warmth.label" : {
      "comment" : "Adjustment control name (color.warmth).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Temperature" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "色温" } }
      }
    },
    "ctrl.develop.colorNR.help" : {
      "comment" : "Adjustment control help (develop.colorNR).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Colour noise reduction while the RAW file is developed." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RAW 冲洗时的色彩降噪。" } }
      }
    },
    "ctrl.develop.colorNR.label" : {
      "comment" : "Adjustment control name (develop.colorNR).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Color noise reduction" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "色彩降噪" } }
      }
    },
    "ctrl.develop.lensCorrection.help" : {
      "comment" : "Adjustment control help (develop.lensCorrection).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Corrects the lens's distortion and vignetting as the camera describes them." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按相机记录校正镜头畸变和暗角。" } }
      }
    },
    "ctrl.develop.lensCorrection.label" : {
      "comment" : "Adjustment control name (develop.lensCorrection).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Lens correction" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "镜头校正" } }
      }
    },
    "ctrl.develop.luminanceNR.help" : {
      "comment" : "Adjustment control help (develop.luminanceNR).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Luminance noise reduction while the RAW file is developed." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RAW 冲洗时的亮度降噪。" } }
      }
    },
    "ctrl.develop.luminanceNR.label" : {
      "comment" : "Adjustment control name (develop.luminanceNR).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Noise reduction" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "降噪" } }
      }
    },
    "ctrl.develop.sharpness.help" : {
      "comment" : "Adjustment control help (develop.sharpness).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sharpening while the RAW file is developed. Halos show more on an HDR display." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RAW 冲洗时的锐化。锐化光晕在 HDR 屏上更显眼。" } }
      }
    },
    "ctrl.develop.sharpness.label" : {
      "comment" : "Adjustment control name (develop.sharpness).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sharpness" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "锐度" } }
      }
    },
    "ctrl.develop.temperature.help" : {
      "comment" : "Adjustment control help (develop.temperature).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The white balance the RAW file is developed with, in kelvin." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RAW 冲洗所用的白平衡，单位开尔文。" } }
      }
    },
    "ctrl.develop.temperature.label" : {
      "comment" : "Adjustment control name (develop.temperature).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Temperature" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "色温" } }
      }
    },
    "ctrl.develop.tint.help" : {
      "comment" : "Adjustment control help (develop.tint).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The green–magenta part of the RAW white balance." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RAW 白平衡的绿—品红分量。" } }
      }
    },
    "ctrl.develop.tint.label" : {
      "comment" : "Adjustment control name (develop.tint).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tint" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "色调" } }
      }
    },
    "ctrl.hdr.coverage.help" : {
      "comment" : "Adjustment control help (hdr.coverage).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "How much gain broad bright areas such as sky get; low values keep it to small lights and reflections. A weighting, not a share of the image." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "大片亮区（天空、白墙）得到多少增益；低时增益集中在小光源和反光上。这是权重，不是画面面积百分比。" } }
      }
    },
    "ctrl.hdr.coverage.label" : {
      "comment" : "Adjustment control name (hdr.coverage).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Area coverage" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "覆盖面积" } }
      }
    },
    "ctrl.hdr.enabled.help" : {
      "comment" : "Adjustment control help (hdr.enabled).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn the HDR rendition on or off. Off, the photo is exported as its SDR base only." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开或关闭 HDR 版本。关闭后只输出 SDR 底图。" } }
      }
    },
    "ctrl.hdr.enabled.label" : {
      "comment" : "Adjustment control name (hdr.enabled).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "HDR" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "HDR" } }
      }
    },
    "ctrl.hdr.expansionStart.help" : {
      "comment" : "Adjustment control help (hdr.expansionStart).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Only parts of the base brighter than this get HDR gain. Auto uses 25% for expansion and keeps the model's result for AI." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "底图亮度高于这个值的地方才得到增益。自动：扩展取 25%，AI 保持模型结果。" } }
      }
    },
    "ctrl.hdr.expansionStart.label" : {
      "comment" : "Adjustment control name (hdr.expansionStart).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Expansion start" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扩展起点" } }
      }
    },
    "ctrl.hdr.model.help" : {
      "comment" : "Adjustment control help (hdr.model).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The AI model that predicts the highlights." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "预测高光所用的 AI 模型。" } }
      }
    },
    "ctrl.hdr.model.label" : {
      "comment" : "Adjustment control name (hdr.model).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Model" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模型" } }
      }
    },
    "ctrl.hdr.range.help" : {
      "comment" : "Adjustment control help (hdr.range).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "How many stops the brightest highlights may rise above SDR white. Auto follows the content, up to 3 stops." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最亮的高光最多比 SDR 白亮几档。自动：按内容取，最多 3 档。" } }
      }
    },
    "ctrl.hdr.range.label" : {
      "comment" : "Adjustment control name (hdr.range).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Range" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "范围" } }
      }
    },
    "ctrl.hdr.sdrRolloff.help" : {
      "comment" : "Adjustment control help (hdr.sdrRolloff).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Compresses highlights smoothly in the SDR version so the sky keeps its detail there. The HDR version does not change." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "让 SDR 版本里的高光平滑过渡，保留天空和云的层次。HDR 版本不变。" } }
      }
    },
    "ctrl.hdr.sdrRolloff.label" : {
      "comment" : "Adjustment control name (hdr.sdrRolloff).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "SDR highlight rolloff" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "SDR 高光过渡" } }
      }
    },
    "ctrl.hdr.source.help" : {
      "comment" : "Adjustment control help (hdr.source).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Where the HDR highlights come from." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "HDR 高光从哪里来。" } }
      }
    },
    "ctrl.hdr.source.label" : {
      "comment" : "Adjustment control name (hdr.source).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Source" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "来源" } }
      }
    },
    "ctrl.hdr.strength.help" : {
      "comment" : "Adjustment control help (hdr.strength).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scales the HDR gain. 0% shows the SDR base; above 100% is brighter than the source, up to the range." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "缩放 HDR 增益。0% 等于 SDR 底图；高于 100% 比来源更亮，最高到“范围”。" } }
      }
    },
    "ctrl.hdr.strength.label" : {
      "comment" : "Adjustment control name (hdr.strength).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Strength" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "强度" } }
      }
    },
    "ctrl.look.enabled.help" : {
      "comment" : "Adjustment control help (look.enabled).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn the chosen LUT on or off without removing it." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "临时开关所选 LUT，不移除它。" } }
      }
    },
    "ctrl.look.enabled.label" : {
      "comment" : "Adjustment control name (look.enabled).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable LUT" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用 LUT" } }
      }
    },
    "ctrl.look.film.help" : {
      "comment" : "Adjustment control help (look.film).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Emulates a film stock from its measured data: exposure, development and, for a negative, the print on paper. It changes the SDR base; HDR highlights are kept." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按胶片的实测数据模拟：曝光、显影，负片还会印放到相纸上。它改变 SDR 底图，HDR 高光保留。" } }
      }
    },
    "ctrl.look.film.label" : {
      "comment" : "Adjustment control name (look.film).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Film" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "胶片" } }
      }
    },
    "ctrl.look.filmAntihalation.help" : {
      "comment" : "Adjustment control help (look.filmAntihalation).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The film's antihalation layer. Off removes it, as CineStill does to Vision3, for a much stronger glow." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "胶片的防光晕层。关闭即去除该层（CineStill 对 Vision3 的做法），光晕会强得多。" } }
      }
    },
    "ctrl.look.filmAntihalation.label" : {
      "comment" : "Adjustment control name (look.filmAntihalation).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Antihalation" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "防光晕层" } }
      }
    },
    "ctrl.look.filmExposure.help" : {
      "comment" : "Adjustment control help (look.filmExposure).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "How much light the film receives. Auto meters the original photo centre-weighted to middle grey; the light adjustments still apply on top." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "胶片接受的曝光量。自动会以中央加权方式对原图测光，使其落在中灰；光线调整仍叠加在其上。" } }
      }
    },
    "ctrl.look.filmExposure.label" : {
      "comment" : "Adjustment control name (look.filmExposure).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Film exposure" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "胶片曝光" } }
      }
    },
    "ctrl.look.filmGrain.help" : {
      "comment" : "Adjustment control help (look.filmGrain).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The film's grain, from its particle structure on a 35 mm frame. 100% is the stock's own grain; 0% is none." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "胶片颗粒，按其在 35 mm 画幅上的颗粒结构计算。100% 为该胶片本身的颗粒；0% 为无颗粒。" } }
      }
    },
    "ctrl.look.filmGrain.label" : {
      "comment" : "Adjustment control name (look.filmGrain).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Grain" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "颗粒" } }
      }
    },
    "ctrl.look.filmHalation.help" : {
      "comment" : "Adjustment control help (look.filmHalation).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The reddish glow light reflected from the film base adds around bright highlights. 100% is the stock's own." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "片基反射的光在明亮高光周围形成的偏红辉光。100% 为该胶片本身的光晕。" } }
      }
    },
    "ctrl.look.filmHalation.label" : {
      "comment" : "Adjustment control name (look.filmHalation).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Halation" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "光晕" } }
      }
    },
    "ctrl.look.filmStrength.help" : {
      "comment" : "Adjustment control help (look.filmStrength).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Blends the original and the film's result in linear light. 0% bypasses the film; 100% applies it fully." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在线性光中混合原图与胶片结果。0% 关闭胶片；100% 完全应用。" } }
      }
    },
    "ctrl.look.filmStrength.label" : {
      "comment" : "Adjustment control name (look.filmStrength).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Film strength" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "胶片强度" } }
      }
    },
    "ctrl.look.input.help" : {
      "comment" : "Adjustment control help (look.input).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The colour space the LUT expects." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "LUT 期望的输入色彩空间。" } }
      }
    },
    "ctrl.look.input.label" : {
      "comment" : "Adjustment control name (look.input).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Input space" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入空间" } }
      }
    },
    "ctrl.look.lut.help" : {
      "comment" : "Adjustment control help (look.lut).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A colour look from the LUT library." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "LUT 库里的一种调色风格。" } }
      }
    },
    "ctrl.look.lut.label" : {
      "comment" : "Adjustment control name (look.lut).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "LUT" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "LUT" } }
      }
    },
    "ctrl.look.output.help" : {
      "comment" : "Adjustment control help (look.output).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The colour space the LUT produces." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "LUT 输出的色彩空间。" } }
      }
    },
    "ctrl.look.output.label" : {
      "comment" : "Adjustment control name (look.output).",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Output space" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输出空间" } }
      }
    },
    "ctrl.look.strength.help" : {
