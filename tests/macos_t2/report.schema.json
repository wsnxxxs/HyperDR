{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperdr.local/schema/macos-display-t2-report-v1.json",
  "title": "HyperDR macOS display-domain T2 report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "gate",
    "status",
    "decision",
    "platform",
    "renderer",
    "renderer_configuration",
    "provenance",
    "invariants",
    "thresholds",
    "fixtures",
    "failures"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_id": {"const": "hyperdr.display-domain/v1/T2"},
    "gate": {"const": "T2"},
    "status": {"enum": ["pass", "fail"]},
    "decision": {"type": "string", "minLength": 1},
    "platform": {"type": "object"},
    "renderer": {"type": "string", "minLength": 1},
    "renderer_configuration": {"type": "object"},
    "provenance": {"type": "object"},
    "invariants": {"type": "object"},
    "thresholds": {"type": "object"},
    "fixtures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "gamma", "base_size", "gain_size", "nodes"]
      }
    },
    "failures": {"type": "array", "items": {"type": "string"}}
  }
}
