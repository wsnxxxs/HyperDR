    "ios.settings.rawDeveloper.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to RAW photos opened next. The current photo and saved edits keep their recorded developer. An unavailable selected version prevents opening; Automatic can fall back to RAW 8."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于之后打开的 RAW 照片。当前照片和已保存的编辑会保留所记录的开发器。所选版本不可用时将无法打开照片；自动模式可回退至 RAW 8。"
          }
        }
      }
    },
    "ios.error.rawDecoderUnavailable %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAW developer %@ is unavailable for this photo on this system. Choose Automatic or another developer in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前系统无法为这张照片提供 RAW 开发器 %@。请在设置中选择自动或其他开发器。"
          }
        }
      }
    },
