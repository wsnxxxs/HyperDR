{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "hyperdr",
  "version-string": "1.0.0",
  "builtin-baseline": "43643e1f5cf73db40d0d4bd610183348eb09b24e",
  "dependencies": [
    {
      "name": "libavif",
      "features": [
        "aom"
      ]
    },
    "libjpeg-turbo",
    "libpng",
    "tiff",
    "lcms"
  ],
  "default-features": [
    "native-model"
  ],
  "features": {
    "native-model": {
      "description": "Embedded ncnn model runtime for the macOS build. The iOS slices do not link it (P7 moves inference to Core ML, P7-4 deletes ncnn), so their configure presets turn default features off.",
      "dependencies": [
        "ncnn"
      ]
    }
  }
}
